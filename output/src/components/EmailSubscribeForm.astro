---
import type { Language } from '@/types/index';
import { t } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const heading          = t(lang, 'subscribe.heading');
const placeholder      = t(lang, 'subscribe.email_placeholder');
const consentLabel     = t(lang, 'subscribe.consent');
const ctaLabel         = t(lang, 'subscribe.cta');
const successMsg       = t(lang, 'subscribe.success');
const errorMsg         = t(lang, 'subscribe.error');
const consentRequired  = t(lang, 'subscribe.consent_required');
---

<div
  x-data={`{
    email: '',
    consent: false,
    status: 'idle',
    error: '',
    async handleSubscribe() {
      if (!this.consent) {
        this.error = '${consentRequired}';
        return;
      }
      this.error = '';
      this.status = 'loading';
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: this.email, language: '${lang}', consent: true })
        });
        if (res.ok) {
          this.status = 'success';
        } else {
          this.status = 'error';
          this.error = '${errorMsg}';
        }
      } catch {
        this.status = 'error';
        this.error = '${errorMsg}';
      }
    }
  }`}
  class="card bg-base-200 shadow-sm p-6"
>
  <h3 class="text-lg font-semibold mb-4">{heading}</h3>

  <!-- Form fields — hidden once subscription succeeds -->
  <div x-show="status !== 'success'">
    <input
      type="email"
      x-model="email"
      placeholder={placeholder}
      class="input input-bordered w-full mb-3"
    />

    <label class="flex items-start gap-2 cursor-pointer">
      <input
        type="checkbox"
        x-model="consent"
        class="checkbox checkbox-sm mt-0.5"
      />
      <span class="text-sm">{consentLabel}</span>
    </label>

    <button
      class="btn btn-primary w-full mt-4"
      :disabled="status === 'loading' || !consent"
      @click.prevent="handleSubscribe()"
    >
      <span x-show="status !== 'loading'">{ctaLabel}</span>
      <span x-show="status === 'loading'" class="loading loading-spinner loading-sm"></span>
    </button>

    <div
      x-show="error"
      x-text="error"
      class="alert alert-error mt-3 text-sm"
    ></div>
  </div>

  <!-- Success state -->
  <div x-show="status === 'success'" class="alert alert-success">
    <span>{successMsg}</span>
  </div>
</div>
