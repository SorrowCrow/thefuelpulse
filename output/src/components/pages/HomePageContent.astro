---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PriceChart from '@/components/PriceChart.astro';
import StationPrices from '@/components/StationPrices.astro';
import NewsFeed from '@/components/NewsFeed.astro';
import FuelSavingsCalculator from '@/components/FuelSavingsCalculator.astro';
import { calculatePriceChange, getPriceTrend } from '@/utils/priceHelpers';
import { normalizeStationWithLabels } from '@/utils/stationHelpers';
import { t, localePath } from '@/i18n/utils';
import pricesData from '@/data/prices.json';
import historyData from '@/data/price-history.json';
import stationData from '@/data/station-prices.json';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const prices = pricesData.averages;
const updated = pricesData.last_updated;

// Normalise stations: support both old schema (prices: {}) and new schema (fuel_entries: [])
const stations = normalizeStationWithLabels(stationData.stations as any[]);

type FuelKey = 'diesel' | 'petrol_95' | 'petrol_98';
function cheapestFor(key: FuelKey) {
  return stations
    .filter((s: any) => s.prices[key] != null)
    .sort((a: any, b: any) => (a.prices[key] as number) - (b.prices[key] as number))[0];
}

// Week-change delta (same logic as PriceCard)
const weekAgoDate = new Date(updated);
weekAgoDate.setDate(weekAgoDate.getDate() - 7);
const weekAgoStr = weekAgoDate.toISOString().split('T')[0];
const prev = historyData.history.find((h: any) => h.date <= weekAgoStr) ?? historyData.history[1];

function weekDelta(curr: number, prevPrice: number | undefined) {
  const { changeValue, changePercentage } = calculatePriceChange(curr, prevPrice);
  const trend = getPriceTrend(changeValue);
  const icon = trend === 'up' ? '<' : trend === 'down' ? '>' : '—';
  const cls = trend === 'up' ? 'badge-error' : trend === 'down' ? 'badge-success' : 'badge-ghost';
  return { changeValue, changePercentage, icon, cls };
}

// Savings banner: cheapest vs. most expensive diesel for a 50L fill
const dieselStations = stations
  .filter((s: any) => s.prices.diesel != null)
  .sort((a: any, b: any) => (a.prices.diesel as number) - (b.prices.diesel as number));
const cheapDiesel = dieselStations[0];
const expDiesel   = dieselStations[dieselStations.length - 1];
const dieselSaving50L = (cheapDiesel && expDiesel && cheapDiesel !== expDiesel)
  ? ((expDiesel.prices.diesel as number) - (cheapDiesel.prices.diesel as number)) * 50
  : 0;
const savingsBanner = dieselSaving50L > 0.01
  ? t(lang, 'hero.savings.msg')
      .replace('{amount}',      dieselSaving50L.toFixed(2))
      .replace('{cheapBrand}',  cheapDiesel.displayLabels?.diesel ?? cheapDiesel.brand)
      .replace('{cheapPrice}',  (cheapDiesel.prices.diesel as number).toFixed(3))
      .replace('{expBrand}',    expDiesel.displayLabels?.diesel ?? expDiesel.brand)
      .replace('{expPrice}',    (expDiesel.prices.diesel as number).toFixed(3))
  : null;

const heroFuels: { key: FuelKey; labelKey: string; avg: number; delta: ReturnType<typeof weekDelta> }[] = [
  { key: 'diesel',    labelKey: 'fuel.diesel',   avg: prices.diesel,    delta: weekDelta(prices.diesel,    prev?.diesel)    },
  { key: 'petrol_95', labelKey: 'fuel.petrol95',  avg: prices.petrol_95, delta: weekDelta(prices.petrol_95, prev?.petrol_95) },
  { key: 'petrol_98', labelKey: 'fuel.petrol98',  avg: prices.petrol_98, delta: weekDelta(prices.petrol_98, prev?.petrol_98) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Fuel Prices in Latvia",
  "description": "Current retail fuel prices (diesel, petrol 95, petrol 98) across major Latvian fuel stations.",
  "url": "https://fuel.lv/",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "dateModified": updated,
  "variableMeasured": [
    { "@type": "PropertyValue", "name": "Diesel price",    "unitText": "EUR per litre", "value": prices.diesel    },
    { "@type": "PropertyValue", "name": "Petrol 95 price", "unitText": "EUR per litre", "value": prices.petrol_95 },
    { "@type": "PropertyValue", "name": "Petrol 98 price", "unitText": "EUR per litre", "value": prices.petrol_98 },
  ]
};

// Last updated time
const scrapedAt = (stationData as any).scraped_at as string;
const localeStr = lang === 'lv' ? 'lv-LV' : lang === 'ru' ? 'ru-RU' : 'en-GB';
const scrapedTime = new Date(scrapedAt).toLocaleTimeString(localeStr, { hour: '2-digit', minute: '2-digit' });

// DUS vs ADUS gap
const viadaStation = (stationData as any).stations?.find((s: any) => s.key === 'viada');
const dusEntry = viadaStation?.fuel_entries?.find((e: any) => e.fuel_type === 'diesel' && e.station_type === 'DUS');
const adusEntry = viadaStation?.fuel_entries?.find((e: any) => e.fuel_type === 'diesel_ecto');
const dusPrice: number | null = dusEntry?.price ?? null;
const adusPrice: number | null = adusEntry?.price ?? null;
const currentGap: number | null = (dusPrice !== null && adusPrice !== null) ? dusPrice - adusPrice : null;

const prevViada = ((historyData as any).history[1])?.stations?.viada;
const prevGap: number | null = (prevViada?.diesel != null && prevViada?.diesel_ecto != null)
  ? prevViada.diesel - prevViada.diesel_ecto : null;
const gapDiff = (currentGap !== null && prevGap !== null) ? currentGap - prevGap : null;
const gapTrend = gapDiff === null ? null : Math.abs(gapDiff) < 0.001 ? 'same' : gapDiff > 0 ? 'wider' : 'narrowed';

// FAQ
const faqKeys = [1,2,3,4,5,6].map(n => ({ q: `faq.${n}.q`, a: `faq.${n}.a` }));
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqKeys.map(({ q, a }) => ({
    "@type": "Question",
    "name": t(lang, q),
    "acceptedAnswer": { "@type": "Answer", "text": t(lang, a) }
  }))
};
---

<BaseLayout lang={lang} title={t(lang, 'meta.home.title')} description={t(lang, 'meta.home.description')}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Intro section -->
  <div class="mb-7" data-reveal>
    <h1 class="text-3xl md:text-4xl font-extrabold mb-2 leading-tight">{t(lang, 'hero.intro.heading')}</h1>
    <p class="text-base-content/60 leading-relaxed mb-4 max-w-2xl">{t(lang, 'hero.intro.p')}</p>
    <div class="flex flex-wrap gap-2 text-xs">
      <a
        href="#prices"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-base-content/20 text-base-content/50 hover:border-primary hover:text-primary hover:bg-primary/10 transition-all duration-150 no-underline whitespace-nowrap"
        @click.prevent="document.getElementById('prices').scrollIntoView({behavior:'smooth',block:'center'})"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        {t(lang, 'hero.intro.badge1')}
      </a>
      <a
        href={`${localePath('/in-depth', lang)}#station-history`}
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-base-content/20 text-base-content/50 hover:border-primary hover:text-primary hover:bg-primary/10 transition-all duration-150 no-underline whitespace-nowrap"
        data-scroll-target="station-history"
        data-scroll-url={localePath('/in-depth', lang)}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M3 10h18M3 14h18M10 3v18M14 3v18" stroke-linecap="round"/>
        </svg>
        {t(lang, 'hero.intro.badge2')}
      </a>
      <a
        href={`${localePath('/in-depth', lang)}#ai-recommendation`}
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-base-content/20 text-base-content/50 hover:border-primary hover:text-primary hover:bg-primary/10 transition-all duration-150 no-underline whitespace-nowrap"
        data-scroll-target="ai-recommendation"
        data-scroll-url={localePath('/in-depth', lang)}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
        {t(lang, 'hero.intro.badge3')}
      </a>

      <script>
        document.querySelectorAll<HTMLAnchorElement>('a[data-scroll-target]').forEach(a => {
          a.addEventListener('click', e => {
            e.preventDefault();
            const target = a.dataset.scrollTarget!;
            const url = a.dataset.scrollUrl!;
            sessionStorage.setItem('scrollTarget', target);
            window.location.href = url;
          });
        });
      </script>
    </div>
  </div>

  <!-- Savings callout banner -->
  {savingsBanner && (
    <div role="alert" class="alert bg-success/10 border border-success/30 text-sm mb-6 gap-3" data-reveal>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{savingsBanner}</span>
    </div>
  )}

  <!-- Hero: 3 big numbers + cheapest station per fuel type -->
  <section id="prices" class="mb-8" aria-label={t(lang, 'price.title')}>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {heroFuels.map(({ key, labelKey, avg, delta }) => {
        const best = cheapestFor(key);
        return (
          <div class="rounded-2xl bg-base-100 border border-base-300 shadow-xl p-6 flex flex-col gap-2" data-reveal>
            <span class="text-xs uppercase tracking-widest text-base-content/40 font-medium">
              {t(lang, labelKey)}
            </span>
            <div class="flex items-baseline gap-1">
              <span class="text-5xl font-extrabold tabular-nums text-primary leading-none">
                {avg.toFixed(3)}
              </span>
              <span class="text-lg text-base-content/50">€/L</span>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class:list={['badge badge-sm text-xs', delta.cls]}>
                {delta.icon} {Math.abs(delta.changeValue).toFixed(3)}
              </span>
              {delta.changePercentage !== 0 &&
                <span class="text-xs text-base-content/40">({delta.changePercentage.toFixed(1)}%)</span>
              }
              <span class="text-xs text-base-content/30">{t(lang, 'price.vs_week').replace('{date}', prev?.date ?? '')}</span>
            </div>
            {best && (
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-base-content/40">{t(lang, 'cheapest.title')}:</span>
                <span class="text-sm font-semibold text-success">{best.brand}</span>
                <span class="text-sm tabular-nums text-success">{(best.prices[key] as number).toFixed(3)} €</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <p class="text-xs text-base-content/30 text-right -mt-4 mb-6">{t(lang, 'price.updated').replace('{time}', scrapedTime)}</p>

  <!-- DUS vs ADUS gap tracker -->
  {currentGap !== null && (
    <div class="mb-8" data-reveal>
      <div class="stats bg-base-100 border border-base-300 shadow-xl w-full">
        <div class="stat">
          <div class="stat-title">{t(lang, 'hero.dus_adus.title')}</div>
          <div class="stat-value text-2xl tabular-nums">{currentGap.toFixed(3)} <span class="text-base font-normal text-base-content/50">€/L</span></div>
          <div class="stat-desc flex items-center gap-1 flex-wrap">
            <span>{t(lang, 'hero.dus_adus.desc')}</span>
            {gapTrend && gapTrend !== 'same' && (
              <span class:list={['badge badge-xs ml-1', gapTrend === 'wider' ? 'badge-warning' : 'badge-success']}>
                {t(lang, gapTrend === 'wider' ? 'hero.dus_adus.wider' : 'hero.dus_adus.narrowed')}
              </span>
            )}
          </div>
        </div>
        <div class="stat">
          <div class="stat-title">Viada DUS</div>
          <div class="stat-value text-xl text-error tabular-nums">{(dusPrice ?? 0).toFixed(3)} €</div>
        </div>
        <div class="stat">
          <div class="stat-title">Viada ADUS</div>
          <div class="stat-value text-xl text-success tabular-nums">{(adusPrice ?? 0).toFixed(3)} €</div>
        </div>
      </div>
    </div>
  )}

  <!-- Main content grid -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-0">
      <StationPrices lang={lang} />
      <FuelSavingsCalculator lang={lang} />
      <PriceChart lang={lang} />
      <!-- CTA to in-depth page -->
      <div class="card bg-base-200 border border-base-300 p-4 mb-8 flex flex-row items-center justify-between gap-4" data-reveal>
        <span class="text-sm text-base-content/70">{t(lang, 'indepth.cta.text')}</span>
        <a href={localePath('/in-depth', lang)} class="btn btn-sm btn-primary whitespace-nowrap">{t(lang, 'indepth.cta.link')}</a>
      </div>
    </div>
    <div class="lg:col-span-1">
      <NewsFeed lang={lang} limit={3} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="mt-12 mb-8" data-reveal>
    <h2 class="text-xl font-bold mb-4">{t(lang, 'faq.title')}</h2>
    <div class="space-y-1">
      {faqKeys.map(({ q, a }) => (
        <div class="collapse collapse-arrow bg-base-100 border border-base-300">
          <input type="checkbox" />
          <div class="collapse-title text-sm font-medium">{t(lang, q)}</div>
          <div class="collapse-content">
            <p class="text-sm text-base-content/70 leading-relaxed pt-1">{t(lang, a)}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
