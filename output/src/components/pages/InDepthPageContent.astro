---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FuelRecommendation from '@/components/FuelRecommendation.astro';
import FuelSavingsCalculator from '@/components/FuelSavingsCalculator.astro';
import StationPriceChart from '@/components/StationPriceChart.astro';
import NewsFeed from '@/components/NewsFeed.astro';
import { t, localePath } from '@/i18n/utils';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'meta.indepth.title')} description={t(lang, 'meta.indepth.description')}>
  <script>
    const target = sessionStorage.getItem('scrollTarget');
    if (target) {
      sessionStorage.removeItem('scrollTarget');
      window.scrollTo(0, 0);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const el = document.getElementById(target);
          if (!el) return;
          const HEADER = 64;
          const start = 0;
          const end = el.getBoundingClientRect().top + window.scrollY - HEADER;
          const duration = 150;
          const t0 = performance.now();
          function step(now: number) {
            const p = Math.min((now - t0) / duration, 1);
            const ease = p < 0.5 ? 2*p*p : -1+(4-2*p)*p;
            window.scrollTo(0, start + (end - start) * ease);
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        });
      });
    }
  </script>
  <div class="mb-6">
    <nav aria-label="breadcrumb">
      <div class="breadcrumbs text-xs text-base-content/40 p-0 min-h-0">
        <ul>
          <li><a href={localePath('/', lang)} class="hover:text-primary">{t(lang, 'nav.home')}</a></li>
          <li>{t(lang, 'nav.indepth')}</li>
        </ul>
      </div>
    </nav>
  </div>
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <FuelRecommendation lang={lang} />
      <FuelSavingsCalculator lang={lang} />
      <StationPriceChart lang={lang} />
    </div>
    <div class="lg:col-span-1">
      <NewsFeed lang={lang} />
    </div>
  </section>
</BaseLayout>
