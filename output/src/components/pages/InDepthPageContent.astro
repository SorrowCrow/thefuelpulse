---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FuelRecommendation from '@/components/FuelRecommendation.astro';
import FuelSavingsCalculator from '@/components/FuelSavingsCalculator.astro';
import StationPriceChart from '@/components/StationPriceChart.astro';
import NewsFeed from '@/components/NewsFeed.astro';
import { t, localePath } from '@/i18n/utils';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'meta.indepth.title')} description={t(lang, 'meta.indepth.description')}>
  <div class="mb-6">
    <nav aria-label="breadcrumb">
      <div class="breadcrumbs text-xs text-base-content/40 p-0 min-h-0">
        <ul>
          <li><a href={localePath('/', lang)} class="hover:text-primary">{t(lang, 'nav.home')}</a></li>
          <li>{t(lang, 'nav.indepth')}</li>
        </ul>
      </div>
    </nav>
  </div>
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <FuelRecommendation lang={lang} />
      <FuelSavingsCalculator lang={lang} />
      <StationPriceChart lang={lang} />
    </div>
    <div class="lg:col-span-1">
      <NewsFeed lang={lang} />
    </div>
  </section>
</BaseLayout>
