---
import newsRaw from '@/data/news-raw.json';

const articles = (newsRaw as { articles: { title: string; url: string; description: string; published_at: string; source: string }[] }).articles.slice(0, 5);
---

<div class="card bg-base-100 border border-base-300 shadow-xl p-4 md:p-6" data-reveal data-reveal-delay="200ms">
  <div class="card-body p-0">
    <div class="flex items-center justify-between mb-4">
      <h2 class="card-title text-2xl md:text-3xl">Latest News</h2>
      <a href="/news" class="text-xs text-primary hover:underline underline-offset-2">View all →</a>
    </div>
    <div class="space-y-4">
      {articles.length === 0 && (
        <p class="text-sm text-base-content/50">No news articles available.</p>
      )}
      {articles.map((article, i) => (
        <div class="card bg-base-200 border border-base-300" data-reveal data-reveal-delay={`${i * 80 + 250}ms`}>
          <div class="card-body p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="badge badge-ghost text-xs">{article.source}</span>
              {article.published_at && (
                <time class="text-xs text-base-content/50">{article.published_at.slice(0, 10)}</time>
              )}
            </div>
            <h3 class="font-semibold text-base leading-snug mb-1">
              <a
                href={article.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary transition-colors"
              >{article.title}</a>
            </h3>
            {article.description && (
              <p class="text-sm text-base-content/70 leading-relaxed">{article.description}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
