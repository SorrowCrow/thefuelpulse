---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localePath, getCanonicalPath } from '@/i18n/utils';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const canonical = getCanonicalPath(Astro.url.pathname);

const navLinks = [
  { key: 'nav.home',     path: '/'          },
  { key: 'nav.indepth',  path: '/in-depth'  },
  { key: 'nav.news',     path: '/news'      },
  { key: 'nav.articles', path: '/articles'  },
  { key: 'nav.about',    path: '/about'     },
  { key: 'nav.contact',  path: '/contact'   },
];
---

<header id="site-header" class="bg-base-100 border-b border-base-300 sticky top-0 z-50">
  <div class="navbar container mx-auto px-4">
    <div class="navbar-start items-center gap-2">
      <!-- Mobile menu trigger (hidden on lg+) -->
      <button
        id="mobile-menu-btn"
        class="btn btn-ghost min-h-[44px] min-w-[44px] lg:hidden"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
      </button>

      <a href={localePath('/', lang)} class="btn btn-ghost text-base font-semibold tracking-tight">
        {t(lang, 'site.name')}
      </a>
      <ul class="menu menu-horizontal hidden lg:flex px-0 flex-nowrap">
        {navLinks.map(({ key, path }) => (
          <li><a href={localePath(path, lang)} class="btn btn-ghost btn-xs text-sm">{t(lang, key)}</a></li>
        ))}
      </ul>
    </div>
    <div class="navbar-end gap-2">
      <LanguageSwitcher lang={lang} />
      <button id="pwa-install-btn" class="btn btn-ghost btn-sm gap-1 hidden" aria-label={t(lang, 'pwa.install')}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/>
        </svg>
        <span class="hidden sm:inline text-xs">{t(lang, 'pwa.install')}</span>
      </button>
      <button id="theme-toggle" class="btn btn-ghost btn-sm btn-circle" aria-label="Toggle theme">
        <!-- Sun icon — shown in dark mode (switch to light) -->
        <svg class="theme-icon-sun w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon — shown in light mode (switch to dark) -->
        <svg class="theme-icon-moon w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav drawer — lives outside header to avoid stacking-context issues -->
<dialog id="mobile-menu-dialog" class="mobile-nav-dialog">
  <div class="mobile-nav-panel">
    <div class="mobile-nav-header">
      <span class="font-semibold text-base">{t(lang, 'site.name')}</span>
      <button id="mobile-menu-close" class="btn btn-ghost btn-sm btn-circle" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <ul class="menu menu-lg p-4 gap-1 w-full">
      {navLinks.map(({ key, path }) => (
        <li class="w-full">
          <a href={localePath(path, lang)} class="text-base py-3 w-full">
            {t(lang, key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</dialog>

<style>
  .mobile-nav-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  @keyframes backdropIn {
    from { background: rgb(0 0 0 / 0); }
    to   { background: rgb(0 0 0 / 0.5); }
  }

  .mobile-nav-dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
    animation: backdropIn 0.25s ease forwards;
  }

  .mobile-nav-panel {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 18rem;
    background-color: var(--color-base-200);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgb(0 0 0 / 0.3);
    will-change: transform;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-base-300);
  }

  .mobile-nav-panel .menu li > a {
    width: 100%;
  }
</style>

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    if (!header) return;
    function onScroll() {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Mobile nav dialog ──
    var dialog = document.getElementById('mobile-menu-dialog');
    var openBtn = document.getElementById('mobile-menu-btn');
    var closeBtn = document.getElementById('mobile-menu-close');
    var panel = dialog ? dialog.querySelector('.mobile-nav-panel') : null;
    var PANEL_W = 288; // 18rem in px

    function setTransform(x) {
      panel.style.transform = 'translateX(' + x + 'px)';
    }

    function openMenu() {
      panel.style.transition = 'none';
      setTransform(-PANEL_W);       // start off-screen
      dialog.showModal();
      panel.offsetHeight;           // force reflow — commits start position
      panel.style.transition = 'transform 0.25s ease';
      setTransform(0);              // animate in
    }

    function closeMenu(fromX) {
      panel.style.transition = 'transform 0.25s ease';
      setTransform(-PANEL_W);
      function onEnd(e) {
        if (e.propertyName !== 'transform') return;
        panel.removeEventListener('transitionend', onEnd);
        panel.style.transition = '';
        panel.style.transform = '';
        dialog.close();
      }
      panel.addEventListener('transitionend', onEnd);
    }

    if (openBtn) openBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', function () { closeMenu(); });

    if (dialog) {
      dialog.addEventListener('click', function (e) {
        if (panel && !panel.contains(e.target)) closeMenu();
      });
      dialog.addEventListener('cancel', function (e) {
        e.preventDefault();
        closeMenu();
      });
    }

    // ── Swipe to close — listen on the whole dialog so backdrop area works too ──
    if (dialog) {
      var closeStartX = 0;
      var closeStartY = 0;
      var closeSwiping = false;

      dialog.addEventListener('touchstart', function (e) {
        closeStartX = e.touches[0].clientX;
        closeStartY = e.touches[0].clientY;
        closeSwiping = true;
        if (panel.contains(e.target)) panel.style.transition = 'none';
      }, { passive: true });

      dialog.addEventListener('touchmove', function (e) {
        if (!closeSwiping) return;
        var dx = e.touches[0].clientX - closeStartX;
        var dy = Math.abs(e.touches[0].clientY - closeStartY);
        // Cancel if gesture turns vertical
        if (dy > Math.abs(dx) && dy > 10) { closeSwiping = false; return; }
        if (dx < 0 && panel.contains(e.target)) setTransform(dx);
      }, { passive: true });

      dialog.addEventListener('touchend', function (e) {
        if (!closeSwiping) return;
        closeSwiping = false;
        var dx = e.changedTouches[0].clientX - closeStartX;
        var dy = Math.abs(e.changedTouches[0].clientY - closeStartY);
        if (dx < -40 && Math.abs(dx) > dy) {
          closeMenu();
        } else {
          panel.style.transition = 'transform 0.25s ease';
          setTransform(0);
        }
      }, { passive: true });
    }


    // ── PWA install prompt ──
    var installBtn = document.getElementById('pwa-install-btn');
    var deferredPrompt = null;
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferredPrompt = e;
      if (installBtn) installBtn.classList.remove('hidden');
    });
    if (installBtn) {
      installBtn.addEventListener('click', function () {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(function () {
          deferredPrompt = null;
          installBtn.classList.add('hidden');
        });
      });
    }
    window.addEventListener('appinstalled', function () {
      deferredPrompt = null;
      if (installBtn) installBtn.classList.add('hidden');
    });

    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var html = document.documentElement;
      var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      try { localStorage.setItem('fuel-theme', next); } catch(e) {}
    });
  })();
</script>
