---
import { t } from '@/i18n/utils';
import recData from '@/data/fuel-recommendation.json';
import { formatDateTime } from '@/utils/dateHelpers';
import type { Language } from '@/types';
import ToggleButton from '@/components/ToggleButton.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

type LangMap = { lv: string; en: string; ru: string };
type FuelBlock = { recommendation: string; confidence: string; summary: LangMap | string };

const data = recData as {
  diesel:          FuelBlock;
  petrol_95:       FuelBlock;
  petrol_98:       FuelBlock;
  factors:         (LangMap | string)[];
  analysis:        LangMap | string;
  sources:         { title: string; url: string; published_at: string }[];
  generated_at:    string;
  prices_snapshot: Record<string, number | null>;
};

function pickLang(val: LangMap | string, l: Language): string {
  if (typeof val === 'string') return val;
  return val[l] ?? val.en ?? '';
}

const cfgMap: Record<string, { badgeClass: string; borderClass: string; bgClass: string; recKey: string; icon: string }> = {
  buy:     { badgeClass: 'badge-success', borderClass: 'border-success/40', bgClass: 'bg-success/5',  recKey: 'rec.buy',     icon: '⛽' },
  wait:    { badgeClass: 'badge-error',   borderClass: 'border-error/40',   bgClass: 'bg-error/5',    recKey: 'rec.wait',    icon: '⏳' },
  neutral: { badgeClass: 'badge-ghost',   borderClass: 'border-base-300',   bgClass: 'bg-base-100',   recKey: 'rec.monitor', icon: '📊' },
};

const confKeyMap: Record<string, string> = {
  high: 'rec.conf.high', medium: 'rec.conf.medium', low: 'rec.conf.low',
};

const fuels: { key: keyof typeof data; labelKey: string }[] = [
  { key: 'diesel',    labelKey: 'fuel.diesel'   },
  { key: 'petrol_95', labelKey: 'fuel.petrol95' },
  { key: 'petrol_98', labelKey: 'fuel.petrol98' },
];

const fuelCards = fuels.map(({ key, labelKey }) => {
  const fb   = data[key] as FuelBlock;
  const cfg  = cfgMap[fb.recommendation] ?? cfgMap.neutral;
  const conf = t(lang, confKeyMap[fb.confidence] ?? 'rec.conf.low');
  const tipKey = `rec.tips.${fb.recommendation ?? 'neutral'}.${fb.confidence ?? 'low'}`;
  const tip  = t(lang, tipKey);
  const snap = data.prices_snapshot[key as string];
  const cdescKey = `rec.confdesc.${fb.confidence ?? 'low'}`;
  const cdesc = t(lang, cdescKey);
  const recLabel = t(lang, cfg.recKey);
  const label = t(lang, labelKey);
  const summary = pickLang(fb.summary, lang);
  return { label, fb, cfg, conf, tip, snap, cdesc, recLabel, summary };
});

const hasAnalysis = !!data.analysis && pickLang(data.analysis, lang).trim().length > 0;
const hasSources  = data.sources && data.sources.length > 0;

const showmore = t(lang, 'rec.showmore');
const showless = t(lang, 'rec.showless');
const showfactors = t(lang, 'rec.factors');
const hidefactors = t(lang, 'rec.hidefactors');
const showsources = t(lang, 'rec.sources');
const hidesources = t(lang, 'rec.hidesources');
const showanalysis = t(lang, 'rec.showanalysis');
const hideanalysis = t(lang, 'rec.hideanalysis');
---

<div class="mb-8" data-reveal>

  <!-- Header -->
  <div class="flex items-center gap-2 mb-4">
    <span class="label-eyebrow">{t(lang, 'rec.title')}</span>
    <span class="text-xs text-base-content/30 ml-auto">
      {formatDateTime(data.generated_at, 'en')}
    </span>
  </div>

  <!-- Per-fuel cards row -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
    {fuelCards.map(({ label, fb, cfg, conf, tip, snap, cdesc, recLabel, summary }) => (
      <div class:list={['card border p-4', cfg.bgClass, cfg.borderClass]}
           x-data={`{ expanded: false, showmore: ${JSON.stringify(showmore)}, showless: ${JSON.stringify(showless)} }`}>
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold text-base-content/70">{label}</span>
          <span class="text-xl" aria-hidden="true">{cfg.icon}</span>
        </div>

        <!-- Recommendation badge with confidence tooltip -->
        <div class="flex items-center gap-2 mb-1">
          <div class="tooltip tooltip-bottom" data-tip={`${recLabel} · ${conf} ${t(lang, 'rec.conf.suffix')}\n${cdesc}`}>
            <span class:list={['badge badge-sm font-bold cursor-help whitespace-normal text-center h-auto py-0.5 leading-tight', cfg.badgeClass]}>{recLabel}</span>
          </div>
          <span class="text-xs text-base-content/40">{conf} {t(lang, 'rec.conf.suffix')}</span>
        </div>

        <!-- Practical fill-up advice (always visible) -->
        <p class="text-xs text-primary/70 font-medium leading-snug mb-2">{tip}</p>

        <!-- AI summary — collapsed by default, expand on tap -->
        <div>
          <p class="text-xs text-base-content/60 leading-snug"
             :class="expanded ? '' : 'line-clamp-2'">{summary}</p>
          <ToggleButton showText={showmore} hideText={showless} stateVar="expanded" class="mt-1" />
        </div>

        {snap !== null && snap !== undefined && (
          <p class="text-xs text-base-content/30 mt-2">{snap.toFixed(3)} EUR/L</p>
        )}
      </div>
    ))}
  </div>

  <!-- Key factors (collapsible) -->
  {data.factors.length > 0 && (
    <div class="mb-3"
         x-data={`{ open: false, showfactors: ${JSON.stringify(showfactors)}, hidefactors: ${JSON.stringify(hidefactors)} }`}>
      <ToggleButton showText={showfactors} hideText={hidefactors} class="mb-1.5 ml-1" />
      <div x-show="open" x-transition>
        <ul class="space-y-1.5 px-1">
          {data.factors.map((f) => (
            <li class="flex items-start gap-2 text-sm text-base-content/70">
              <span class="text-base-content/30 mt-0.5 shrink-0">›</span>
              <span>{pickLang(f, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- News sources (collapsible) -->
  {hasSources && (
    <div class="mb-3"
         x-data={`{ open: false, showsources: ${JSON.stringify(showsources)}, hidesources: ${JSON.stringify(hidesources)} }`}>
      <ToggleButton showText={showsources} hideText={hidesources} class="mb-1.5 ml-1" />
      <div x-show="open" x-transition>
        <ul class="space-y-1">
          {data.sources.map((s: { title: string; url: string; published_at: string }) => (
            <li class="text-xs flex items-start gap-2">
              <span class="text-base-content/30 shrink-0 mt-0.5">›</span>
              <span>
                <a href={s.url} target="_blank" rel="noopener noreferrer"
                   class="text-base-content/60 hover:text-primary transition-colors underline-offset-2 hover:underline">
                  {s.title}
                </a>
                {s.published_at && (
                  <span class="ml-2 text-base-content/30">{s.published_at.slice(0, 10)}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- Analysis toggle -->
  {hasAnalysis && (
    <div x-data={`{ open: false, showanalysis: ${JSON.stringify(showanalysis)}, hideanalysis: ${JSON.stringify(hideanalysis)} }`}>
      <button
        class="btn btn-ghost btn-xs text-xs gap-1"
        x-on:click="open = !open"
      >
        <span x-text="open ? hideanalysis : showanalysis">{showanalysis}</span>
      </button>

      <div x-show="open" x-transition class="mt-3">
        <div class="card bg-base-200 border border-base-300 p-4 rounded-lg">
          <p class="text-sm text-base-content/80 leading-relaxed whitespace-pre-line">{pickLang(data.analysis, lang)}</p>
        </div>
      </div>
    </div>
  )}

</div>
