---
import historyData from '@/data/price-history.json';
import { formatShortDate } from '@/utils/dateHelpers';
import { t } from '@/i18n/utils';
import type { Language } from '@/types';
import { getSharedTooltipConfig, getSharedScaleConfig } from '@/utils/chartHelpers';
import { rangeFilterMixin } from '@/scripts/alpineRangeFilter';
const _rangeFilterJson = JSON.stringify(rangeFilterMixin());

const _tooltipJson = JSON.stringify(getSharedTooltipConfig());
const _scales = getSharedScaleConfig('rgba(127,127,127,0.07)');
const _scaleXJson = JSON.stringify(_scales.x);
const _scaleYBaseJson = JSON.stringify(_scales.y);

interface Props { lang: Language; }
const { lang } = Astro.props;

// All colors pre-computed — no regex inside Alpine x-data (backslashes get stripped by HTML encoding)
const STATIONS = [
  { key: 'virsi',     label: 'Virši',      color: 'rgba(251,191,36,0.9)',  fillColor: 'rgba(251,191,36,0.07)',  borderDash: [] as number[] },
  { key: 'circlek',   label: 'Circle K',   color: 'rgba(248,113,113,0.9)', fillColor: 'rgba(248,113,113,0.07)', borderDash: [] as number[] },
  { key: 'neste',     label: 'Neste',      color: 'rgba(52,211,153,0.9)',  fillColor: 'rgba(52,211,153,0.07)',  borderDash: [] as number[] },
  { key: 'viada',     label: 'Viada DUS',  color: 'rgba(167,139,250,0.9)', fillColor: 'rgba(167,139,250,0.07)', borderDash: [] as number[] },
  { key: 'viada_adus',label: 'Viada ADUS', color: 'rgba(196,181,253,0.85)',fillColor: 'rgba(196,181,253,0.03)', borderDash: [5,3] as number[] },
  { key: 'kool',      label: 'Kool',       color: 'rgba(56,189,248,0.9)',  fillColor: 'rgba(56,189,248,0.07)',  borderDash: [] as number[] },
];

type FuelKey = 'diesel' | 'petrol_95' | 'petrol_98' | 'lpg' | 'cng' | 'hvo' | 'e85';

type StationBucket = { diesel: number[]; petrol_95: number[]; petrol_98: number[]; lpg: number[]; cng: number[]; hvo: number[]; e85: number[] };

// Group multiple polls per day, average per station, oldest-first
const grouped = new Map<string, {
  date: string;
  stations: Record<string, StationBucket>;
}>();

const emptyBucket = (): StationBucket => ({ diesel: [], petrol_95: [], petrol_98: [], lpg: [], cng: [], hvo: [], e85: [] });

for (const item of historyData.history) {
  if (!grouped.has(item.date)) {
    const stationBuckets: Record<string, StationBucket> = {};
    for (const s of STATIONS) stationBuckets[s.key] = emptyBucket();
    grouped.set(item.date, { date: item.date, stations: stationBuckets });
  }
  const g = grouped.get(item.date)!;
  const stationPrices = (item as Record<string, unknown>).stations as Record<string, Record<string, number | null>> | undefined;
  if (stationPrices) {
    for (const s of STATIONS) {
      if (s.key === 'viada_adus') {
        // Read diesel_ecto from viada's history entry
        const viadaSp = stationPrices['viada'] as any;
        if (viadaSp?.diesel_ecto != null) g.stations['viada_adus'].diesel.push(viadaSp.diesel_ecto);
        // petrol for ADUS is same as DUS — omit to avoid duplicate lines on petrol tabs
        // lpg is ADUS-only — read from viada entry
        if (viadaSp?.lpg != null) g.stations['viada_adus'].lpg.push(viadaSp.lpg);
      } else {
        const sp = stationPrices[s.key] as any;
        if (!sp) continue;
        if (sp.diesel    != null) g.stations[s.key].diesel.push(sp.diesel);
        if (sp.petrol_95 != null) g.stations[s.key].petrol_95.push(sp.petrol_95);
        if (sp.petrol_98 != null) g.stations[s.key].petrol_98.push(sp.petrol_98);
        // Specialty fuels per station
        if (s.key === 'virsi') {
          if (sp.cng != null) g.stations['virsi'].cng.push(sp.cng);
          if (sp.lpg != null) g.stations['virsi'].lpg.push(sp.lpg);
        } else if (s.key === 'circlek') {
          if (sp.lpg != null) g.stations['circlek'].lpg.push(sp.lpg);
        } else if (s.key === 'neste') {
          if (sp.hvo != null) g.stations['neste'].hvo.push(sp.hvo);
        } else if (s.key === 'viada') {
          // DUS series: e85 only; lpg belongs to viada_adus
          if (sp.e85 != null) g.stations['viada'].e85.push(sp.e85);
        }
        // kool: no specialty fuels — buckets remain empty
      }
    }
  }
}

const _avg = (arr: number[]) => arr.length ? arr.reduce((a, b) => a + b, 0) / arr.length : null;

const allHistory = [...grouped.values()]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map(g => ({
    date: g.date,
    label: formatShortDate(g.date, lang),
    stations: Object.fromEntries(
      STATIONS.map(s => [s.key, {
        diesel:    _avg(g.stations[s.key].diesel),
        petrol_95: _avg(g.stations[s.key].petrol_95),
        petrol_98: _avg(g.stations[s.key].petrol_98),
        lpg:       _avg(g.stations[s.key].lpg),
        cng:       _avg(g.stations[s.key].cng),
        hvo:       _avg(g.stations[s.key].hvo),
        e85:       _avg(g.stations[s.key].e85),
      }])
    ),
  }));

const allHistoryJson = JSON.stringify(allHistory);
const stationsJson = JSON.stringify(STATIONS);
---

<div id="station-history" class="card bg-base-100 border border-base-300 shadow-xl p-4 md:p-6 mb-8" data-reveal data-reveal-delay="100ms" style="scroll-margin-top: calc(4rem + 15vh)">
  <div
    class="card-body p-0"
    x-data={`{
      fuel: 'diesel',
      isolatedStation: null,
        ...${_rangeFilterJson},
        history: ${allHistoryJson},
        stations: ${stationsJson},

        filteredData() {
          if (this.range === '7d')  return this.history.slice(-7);
          if (this.range === '30d') return this.history.slice(-30);
          let r = this.history;
          if (this.fromDate) r = r.filter(e => e.date >= this.fromDate);
          if (this.toDate)   r = r.filter(e => e.date <= this.toDate);
          return r;
        },

        setFuel(f) {
          this.fuel = f;
          this.$nextTick(() => this.updateChart());
        },

        setRange(r) {
          this.range = r;
          this.$nextTick(() => this.updateChart());
        },

        isolateStation(key) {
          this.isolatedStation = this.isolatedStation === key ? null : key;
          const chart = Chart.getChart(this.$refs.stationChart);
          if (!chart) return;
          chart.data.datasets.forEach((ds, i) => {
            const s = this.stations[i];
            const muted = this.isolatedStation && s.key !== this.isolatedStation;
            ds.borderColor = muted ? 'rgba(127,127,127,0.25)' : s.color;
            ds.backgroundColor = muted ? 'rgba(127,127,127,0.03)' : s.fillColor;
            ds.pointBackgroundColor = muted ? 'rgba(127,127,127,0.25)' : s.color;
            ds.borderWidth = muted ? 1 : (s.borderDash.length ? 1.5 : 2);
          });
          chart.update();
        },

        updateChart() {
          const chart = Chart.getChart(this.$refs.stationChart);
          if (!chart) return;
          const data = this.filteredData();
          const f = this.fuel;
          chart.data.labels = data.map(e => e.label);
          chart.data.datasets.forEach((ds, i) => {
            const s = this.stations[i];
            const muted = this.isolatedStation && s.key !== this.isolatedStation;
            ds.data = data.map(e => e.stations[s.key][f]);
            ds.hidden = false;
            ds.borderColor = muted ? 'rgba(127,127,127,0.25)' : s.color;
            ds.backgroundColor = muted ? 'rgba(127,127,127,0.03)' : s.fillColor;
            ds.pointBackgroundColor = muted ? 'rgba(127,127,127,0.25)' : s.color;
            ds.borderWidth = muted ? 1 : (s.borderDash.length ? 1.5 : 2);
          });
          chart.update();
        },

        init() {
          const ctx = this.$refs.stationChart.getContext('2d');
          const f = this.fuel;
          const initData = this.filteredData();

          const datasets = this.stations.map(s => ({
            label: s.label,
            data: initData.map(e => e.stations[s.key][f]),
            borderColor: s.color,
            borderWidth: s.borderDash.length ? 1.5 : 2,
            borderDash: s.borderDash,
            backgroundColor: s.fillColor,
            pointBackgroundColor: s.color,
            pointRadius: s.borderDash.length ? 3 : 5,
            pointHoverRadius: s.borderDash.length ? 5 : 8,
            tension: 0.35,
            fill: s.borderDash.length ? false : true,
            spanGaps: true,
          }));

          new Chart(ctx, {
            type: 'line',
            data: {
              labels: initData.map(e => e.label),
              datasets,
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: {
                legend: { display: false },
                tooltip: {
                  ...${_tooltipJson},
                  callbacks: {
                    label: function(context) {
                      const v = context.parsed.y;
                      return ' ' + context.dataset.label + ': ' + (v != null ? v.toFixed(3) + ' EUR' : 'N/A');
                    }
                  }
                }
              },
              scales: {
                x: ${_scaleXJson},
                y: {
                  ...${_scaleYBaseJson},
                  ticks: {
                    color: '#71717a',
                    font: { size: 12 },
                    callback: function(value) {
                      return value.toFixed(2) + ' €';
                    }
                  }
                }
              }
            }
          });
        }
      }`}
    >
    <!-- Header row: title + legend -->
    <div class="flex flex-wrap justify-between items-baseline gap-3 mb-4">
      <h2 class="card-title text-2xl md:text-3xl">{t(lang, 'chart.station.title')}</h2>
      <div class="flex flex-wrap gap-4 text-xs text-base-content/50">
        {STATIONS.map(s => (
          <span
            class="flex items-center gap-1.5 cursor-pointer select-none transition-opacity duration-200 rounded-sm px-1 -mx-1"
            :class={`isolatedStation === '${s.key}' ? 'ring-1 ring-base-content/30 text-base-content' : 'hover:text-base-content/80'`}
            :style={`opacity: isolatedStation && isolatedStation !== '${s.key}' ? 0.3 : 1`}
            @click={`isolateStation('${s.key}')`}
            title={t(lang, 'chart.station.isolate_hint')}
          >
            <span class="inline-block w-3 h-3 rounded-full" style={`background:${s.color}`}></span>
            <span class="hover:underline underline-offset-2 decoration-base-content/30">{s.label}</span>
          </span>
        ))}
        <span
          class="flex items-center gap-1 text-base-content/25 transition-opacity duration-200 select-none cursor-pointer hover:text-base-content/50"
          x-show="isolatedStation"
          x-cloak
          @click="isolateStation(isolatedStation)"
          title={t(lang, 'chart.station.clear_title')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          {t(lang, 'chart.station.clear')}
        </span>
      </div>
    </div>

      <!-- Controls row: fuel selector + range selector -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <!-- Fuel type — standard fuels -->
        <div class="join">
          <button class="join-item btn btn-sm" :class="fuel === 'diesel'    ? 'btn-primary' : 'btn-ghost'" @click="setFuel('diesel')">{t(lang, 'fuel.diesel')}</button>
          <button class="join-item btn btn-sm" :class="fuel === 'petrol_95' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('petrol_95')">95</button>
          <button class="join-item btn btn-sm" :class="fuel === 'petrol_98' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('petrol_98')">98</button>
        </div>

        <span class="text-base-content/20 select-none">|</span>

        <!-- Fuel type — specialty fuels -->
        <div class="join">
          <button class="join-item btn btn-sm" :class="fuel === 'lpg' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('lpg')">LPG</button>
          <button class="join-item btn btn-sm" :class="fuel === 'cng' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('cng')">CNG</button>
          <button class="join-item btn btn-sm" :class="fuel === 'hvo' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('hvo')">HVO</button>
          <button class="join-item btn btn-sm" :class="fuel === 'e85' ? 'btn-primary' : 'btn-ghost'" @click="setFuel('e85')">E85</button>
        </div>

        <span class="text-base-content/20 select-none">|</span>

        <!-- Range -->
        <div class="join">
          <button class="join-item btn btn-sm" :class="range === '7d'     ? 'btn-neutral' : 'btn-ghost'" @click="setRange('7d')">7d</button>
          <button class="join-item btn btn-sm" :class="range === '30d'    ? 'btn-neutral' : 'btn-ghost'" @click="setRange('30d')">30d</button>
          <button class="join-item btn btn-sm" :class="range === 'custom' ? 'btn-neutral' : 'btn-ghost'" @click="setRange('custom')">{t(lang, 'chart.custom')}</button>
        </div>

        <!-- Custom date range — shown only when range = custom -->
        <div x-show="range === 'custom'" class="flex items-center gap-2 text-sm">
          <input
            type="date"
            class="input input-sm input-bordered bg-base-200 text-base-content"
            x-model="fromDate"
            @change="updateChart()"
          />
          <span class="text-base-content/40">—</span>
          <input
            type="date"
            class="input input-sm input-bordered bg-base-200 text-base-content"
            x-model="toDate"
            @change="updateChart()"
          />
        </div>
      </div>

      <!-- Chart canvas -->
      <div class="h-64 md:h-80">
        <canvas x-ref="stationChart"></canvas>
      </div>
  </div>
</div>
