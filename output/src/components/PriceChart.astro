---
import historyData from '@/data/price-history.json';
import pricesData from '@/data/prices.json';
import { formatShortDate } from '@/utils/dateHelpers';
import { t } from '@/i18n/utils';
import type { Language } from '@/types';
import { CHART_COLORS } from '@/utils/chartColors';
import { getSharedTooltipConfig, getSharedScaleConfig } from '@/utils/chartHelpers';
import { rangeFilterMixin } from '@/scripts/alpineRangeFilter';
const _rangeFilterJson = JSON.stringify(rangeFilterMixin());

const _tooltipJson = JSON.stringify(getSharedTooltipConfig());
const _scales = getSharedScaleConfig('rgba(255,255,255,0.05)');
const _scaleXJson = JSON.stringify(_scales.x);
const _scaleYBaseJson = JSON.stringify(_scales.y);

interface Props { lang: Language; }
const { lang } = Astro.props;

// Group multiple polls per day, average them, oldest-first for the chart
const grouped = new Map<string, { date: string; d: number[]; p95: number[]; p98: number[] }>();
for (const item of historyData.history) {
  if (!grouped.has(item.date)) {
    grouped.set(item.date, { date: item.date, d: [], p95: [], p98: [] });
  }
  const g = grouped.get(item.date)!;
  if (item.diesel   != null) g.d.push(item.diesel);
  if (item.petrol_95 != null) g.p95.push(item.petrol_95);
  if (item.petrol_98 != null) g.p98.push(item.petrol_98);
}
const _avg = (arr: number[]) => arr.length ? arr.reduce((a, b) => a + b, 0) / arr.length : null;
const allHistory = [...grouped.values()]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map(g => ({
    date: g.date,
    label: formatShortDate(g.date, lang),
    diesel:    _avg(g.d),
    petrol_95: _avg(g.p95),
    petrol_98: _avg(g.p98),
  }));

// Simple linear-regression trend extrapolation (3 forecast days)
function linearForecast(data: typeof allHistory, key: 'diesel' | 'petrol_95' | 'petrol_98', days: number) {
  const vals = data
    .map((e, i) => ({ x: i, y: e[key] as number | null }))
    .filter((e): e is { x: number; y: number } => e.y != null);
  if (vals.length < 2) return Array(days).fill(null) as (number | null)[];
  const n = vals.length;
  const sx = vals.reduce((s, e) => s + e.x, 0);
  const sy = vals.reduce((s, e) => s + e.y, 0);
  const sxy = vals.reduce((s, e) => s + e.x * e.y, 0);
  const sx2 = vals.reduce((s, e) => s + e.x * e.x, 0);
  const denom = n * sx2 - sx * sx;
  if (denom === 0) return Array(days).fill(vals[vals.length - 1].y) as number[];
  const m = (n * sxy - sx * sy) / denom;
  const b = (sy - m * sx) / n;
  return Array.from({ length: days }, (_, i) => {
    const x = n + i;
    return +Math.max(1.0, b + m * x).toFixed(3);
  });
}

const FORECAST_DAYS = 3;
const forecastDiesel    = linearForecast(allHistory, 'diesel',    FORECAST_DAYS);
const forecastPetrol95  = linearForecast(allHistory, 'petrol_95', FORECAST_DAYS);
const forecastPetrol98  = linearForecast(allHistory, 'petrol_98', FORECAST_DAYS);

// Forecast date labels
function addDays(dateStr: string, n: number): string {
  const d = new Date(dateStr + 'T12:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
}
const lastDate = allHistory.length > 0 ? allHistory[allHistory.length - 1].date : new Date().toISOString().slice(0, 10);
const forecastDates = Array.from({ length: FORECAST_DAYS }, (_, i) => addDays(lastDate, i + 1));

// Build extended history that includes forecast slots as null for actual data
const forecastEntries = forecastDates.map((date, i) => ({
  date,
  label: forecastDates[i].slice(5),   // MM-DD
  diesel:    null as number | null,
  petrol_95: null as number | null,
  petrol_98: null as number | null,
}));

const extendedHistory = [...allHistory, ...forecastEntries];
const extendedHistoryJson = JSON.stringify(extendedHistory);
const forecastDieselJson   = JSON.stringify(forecastDiesel);
const forecastPetrol95Json = JSON.stringify(forecastPetrol95);
const forecastPetrol98Json = JSON.stringify(forecastPetrol98);

const allHistoryJson = JSON.stringify(allHistory);
const currency = pricesData.currency;

const labelDiesel = t(lang, 'fuel.diesel');
const labelP95 = t(lang, 'fuel.petrol95');
const labelP98 = t(lang, 'fuel.petrol98');
const labelForecastSuffix = t(lang, 'chart.forecast.suffix');
---

<div class="card bg-base-100 border border-base-300 shadow-xl p-4 md:p-6 mb-8" data-reveal data-reveal-delay="75ms">
  <div class="card-body p-0">
    <!-- Header row: title + legend -->
    <div class="flex justify-between items-baseline mb-4">
      <h2 class="card-title text-2xl md:text-3xl">{t(lang, 'chart.title')}</h2>
      <div class="flex gap-4 text-xs text-base-content/50">
        <span class="flex items-center gap-1">
          <span class="inline-block w-3 h-0.5" style={`background:${CHART_COLORS.diesel.solid}`}></span> {labelDiesel}
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-3 h-0.5" style={`background:${CHART_COLORS.petrol95.solid}`}></span> 95
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block w-3 h-0.5" style={`background:${CHART_COLORS.petrol98.solid}`}></span> 98
        </span>
      </div>
    </div>

    <div
      x-data={`{
        ...${_rangeFilterJson},
        history: ${extendedHistoryJson},
        forecastDiesel:   ${forecastDieselJson},
        forecastPetrol95: ${forecastPetrol95Json},
        forecastPetrol98: ${forecastPetrol98Json},
        showForecast: true,

        filteredData() {
          const actual = this.history.filter(e => e.diesel !== null || e.petrol_95 !== null || e.petrol_98 !== null || !this.history.some(h => h.date < e.date && (h.diesel !== null)));
          // separate actual vs forecast entries
          const realEntries = this.history.filter((e, i) => i < this.history.length - 3);
          const fcastEntries = this.history.slice(-3);
          let r;
          if (this.range === '7d') r = realEntries.slice(-7);
          else if (this.range === '30d') r = realEntries.slice(-30);
          else {
            r = realEntries;
            if (this.fromDate) r = r.filter(e => e.date >= this.fromDate);
            if (this.toDate)   r = r.filter(e => e.date <= this.toDate);
          }
          return this.showForecast ? [...r, ...fcastEntries] : r;
        },

        periodChange(key) {
          const data = this.filteredData().filter(e => e[key] != null);
          if (data.length < 2) return null;
          const first = data[0][key];
          const last  = data[data.length - 1][key];
          const delta = last - first;
          const pct   = first !== 0 ? (delta / first) * 100 : 0;
          return { delta, pct };
        },

        setRange(r) {
          this.range = r;
          this.$nextTick(() => this.updateChart());
        },

        updateChart() {
          const chart = Chart.getChart(this.$refs.priceChart);
          if (!chart) return;
          const data = this.filteredData();
          const realLen = data.filter(e => e.diesel !== null || e.petrol_95 !== null || e.petrol_98 !== null).length;
          // actual datasets
          chart.data.labels = data.map(e => e.label || e.date.slice(5));
          chart.data.datasets[0].data = data.map(e => e.diesel);
          chart.data.datasets[1].data = data.map(e => e.petrol_95);
          chart.data.datasets[2].data = data.map(e => e.petrol_98);
          // forecast datasets: prepend last actual value so line connects
          const lastD   = data.slice(0, realLen).map(e => e.diesel).filter(v => v != null).at(-1) ?? null;
          const lastP95 = data.slice(0, realLen).map(e => e.petrol_95).filter(v => v != null).at(-1) ?? null;
          const lastP98 = data.slice(0, realLen).map(e => e.petrol_98).filter(v => v != null).at(-1) ?? null;
          const nullPad = Array(realLen - 1).fill(null);
          chart.data.datasets[3].data = this.showForecast ? [...nullPad, lastD,   ...this.forecastDiesel  ] : [];
          chart.data.datasets[4].data = this.showForecast ? [...nullPad, lastP95, ...this.forecastPetrol95] : [];
          chart.data.datasets[5].data = this.showForecast ? [...nullPad, lastP98, ...this.forecastPetrol98] : [];
          chart.update();
        },

        init() {
          const ctx = this.$refs.priceChart.getContext('2d');

          const gradientDiesel = ctx.createLinearGradient(0, 0, 0, 320);
          gradientDiesel.addColorStop(0, '${CHART_COLORS.diesel.gradientTop}');
          gradientDiesel.addColorStop(1, '${CHART_COLORS.diesel.gradientBot}');

          const gradient95 = ctx.createLinearGradient(0, 0, 0, 320);
          gradient95.addColorStop(0, '${CHART_COLORS.petrol95.gradientTop}');
          gradient95.addColorStop(1, '${CHART_COLORS.petrol95.gradientBot}');

          const gradient98 = ctx.createLinearGradient(0, 0, 0, 320);
          gradient98.addColorStop(0, '${CHART_COLORS.petrol98.gradientTop}');
          gradient98.addColorStop(1, '${CHART_COLORS.petrol98.gradientBot}');

          const pointStyle = {
            radius: 4,
            hoverRadius: 7,
            borderWidth: 2,
            borderColor: 'rgba(10,10,10,1)',
          };

          const initData = this.filteredData();
          const realLen = initData.filter(e => e.diesel !== null || e.petrol_95 !== null || e.petrol_98 !== null).length;
          const nullPad = Array(realLen - 1).fill(null);
          const lastD   = initData.slice(0,realLen).map(e=>e.diesel).filter(v=>v!=null).at(-1) ?? null;
          const lastP95 = initData.slice(0,realLen).map(e=>e.petrol_95).filter(v=>v!=null).at(-1) ?? null;
          const lastP98 = initData.slice(0,realLen).map(e=>e.petrol_98).filter(v=>v!=null).at(-1) ?? null;

          const forecastStyle = {
            borderDash: [5, 4],
            borderWidth: 1.5,
            radius: 3,
            hoverRadius: 5,
            borderColor: undefined,
            pointBackgroundColor: undefined,
            backgroundColor: 'transparent',
            fill: false,
            tension: 0.3,
            spanGaps: true,
          };

          new Chart(ctx, {
            type: 'line',
            data: {
              labels: initData.map(e => e.label || e.date.slice(5)),
              datasets: [
                {
                  label: '${labelDiesel}',
                  data: initData.map(e => e.diesel),
                  borderColor: '${CHART_COLORS.diesel.border}',
                  borderWidth: 2,
                  backgroundColor: gradientDiesel,
                  pointBackgroundColor: '${CHART_COLORS.diesel.pointBg}',
                  tension: 0.35,
                  fill: true,
                  ...pointStyle,
                },
                {
                  label: '${labelP95}',
                  data: initData.map(e => e.petrol_95),
                  borderColor: '${CHART_COLORS.petrol95.border}',
                  borderWidth: 2,
                  backgroundColor: gradient95,
                  pointBackgroundColor: '${CHART_COLORS.petrol95.pointBg}',
                  tension: 0.35,
                  fill: true,
                  ...pointStyle,
                },
                {
                  label: '${labelP98}',
                  data: initData.map(e => e.petrol_98),
                  borderColor: '${CHART_COLORS.petrol98.border}',
                  borderWidth: 2,
                  backgroundColor: gradient98,
                  pointBackgroundColor: '${CHART_COLORS.petrol98.pointBg}',
                  tension: 0.35,
                  fill: true,
                  ...pointStyle,
                },
                // Forecast datasets (dashed)
                {
                  label: '${labelDiesel} ${labelForecastSuffix}',
                  data: [...nullPad, lastD, ...this.forecastDiesel],
                  ...forecastStyle,
                  borderColor: '${CHART_COLORS.diesel.forecast}',
                  pointBackgroundColor: '${CHART_COLORS.diesel.forecast}',
                },
                {
                  label: '${labelP95} ${labelForecastSuffix}',
                  data: [...nullPad, lastP95, ...this.forecastPetrol95],
                  ...forecastStyle,
                  borderColor: '${CHART_COLORS.petrol95.forecast}',
                  pointBackgroundColor: '${CHART_COLORS.petrol95.forecast}',
                },
                {
                  label: '${labelP98} ${labelForecastSuffix}',
                  data: [...nullPad, lastP98, ...this.forecastPetrol98],
                  ...forecastStyle,
                  borderColor: '${CHART_COLORS.petrol98.forecast}',
                  pointBackgroundColor: '${CHART_COLORS.petrol98.forecast}',
                },
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: {
                legend: { display: false },
                tooltip: {
                  ...${_tooltipJson},
                  filter: function(item) {
                    // Hide forecast dataset items at the bridge point (today's date)
                    // where actual data is also present — only show forecast for future days
                    if (item.datasetIndex >= 3) {
                      return item.chart.data.datasets[0].data[item.dataIndex] === null;
                    }
                    return true;
                  },
                  callbacks: {
                    label: function(context) {
                      return ' ' + context.dataset.label + ': ' + context.parsed.y.toFixed(3) + ' EUR';
                    }
                  }
                }
              },
              scales: {
                x: ${_scaleXJson},
                y: {
                  ...${_scaleYBaseJson},
                  ticks: {
                    color: '#71717a',
                    font: { size: 12 },
                    callback: function(value) {
                      return value.toFixed(2) + ' €';
                    }
                  }
                }
              }
            }
          });
        }
      }`}
    >
      <!-- Range selector -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <div class="join">

          <button
            class="join-item btn btn-sm"
            :class="range === '7d' ? 'btn-primary' : 'btn-ghost'"
            @click="setRange('7d')"
          >7d</button>
          <button
            class="join-item btn btn-sm"
            :class="range === '30d' ? 'btn-primary' : 'btn-ghost'"
            @click="setRange('30d')"
          >30d</button>
          <button
            class="join-item btn btn-sm"
            :class="range === 'custom' ? 'btn-primary' : 'btn-ghost'"
            @click="setRange('custom')"
          >{t(lang, 'chart.custom')}</button>
        </div>

        <!-- Forecast toggle -->
        <label class="flex items-center gap-2 text-xs cursor-pointer select-none">
          <input type="checkbox" class="toggle toggle-xs toggle-primary" x-model="showForecast" @change="updateChart()" />
          <span class="text-base-content/50">{t(lang, 'chart.forecast')}</span>
        </label>

        <!-- Custom date inputs — shown only when range = custom -->
        <div x-show="range === 'custom'" class="flex items-center gap-2 text-sm">
          <input
            type="date"
            class="input input-sm input-bordered bg-base-200 text-base-content"
            x-model="fromDate"
            @change="updateChart()"
          />
          <span class="text-base-content/40">—</span>
          <input
            type="date"
            class="input input-sm input-bordered bg-base-200 text-base-content"
            x-model="toDate"
            @change="updateChart()"
          />
        </div>
      </div>

      <!-- Per-fuel period change stats -->
      <div class="flex flex-wrap gap-4 mb-4">
        <div class="flex items-baseline gap-2 text-sm">
          <span class="text-base-content/40 text-xs">{labelDiesel}</span>
          <span class="tabular font-medium"
                :class="periodChange('diesel') && periodChange('diesel').delta < 0 ? 'text-success' : periodChange('diesel') && periodChange('diesel').delta > 0 ? 'text-error' : 'text-base-content/50'"
                x-text={`periodChange('diesel') ? (periodChange('diesel').delta >= 0 ? '+' : '') + periodChange('diesel').delta.toFixed(3) + ' ${currency}' : '—'`}></span>
          <span class="text-base-content/30 text-xs"
                x-show="periodChange('diesel') !== null"
                x-text="periodChange('diesel') ? '(' + (periodChange('diesel').pct >= 0 ? '+' : '') + periodChange('diesel').pct.toFixed(1) + '%)' : ''"></span>
        </div>
        <div class="flex items-baseline gap-2 text-sm">
          <span class="text-base-content/40 text-xs">{labelP95}</span>
          <span class="tabular font-medium"
                :class="periodChange('petrol_95') && periodChange('petrol_95').delta < 0 ? 'text-success' : periodChange('petrol_95') && periodChange('petrol_95').delta > 0 ? 'text-error' : 'text-base-content/50'"
                x-text={`periodChange('petrol_95') ? (periodChange('petrol_95').delta >= 0 ? '+' : '') + periodChange('petrol_95').delta.toFixed(3) + ' ${currency}' : '—'`}></span>
          <span class="text-base-content/30 text-xs"
                x-show="periodChange('petrol_95') !== null"
                x-text="periodChange('petrol_95') ? '(' + (periodChange('petrol_95').pct >= 0 ? '+' : '') + periodChange('petrol_95').pct.toFixed(1) + '%)' : ''"></span>
        </div>
        <div class="flex items-baseline gap-2 text-sm">
          <span class="text-base-content/40 text-xs">{labelP98}</span>
          <span class="tabular font-medium"
                :class="periodChange('petrol_98') && periodChange('petrol_98').delta < 0 ? 'text-success' : periodChange('petrol_98') && periodChange('petrol_98').delta > 0 ? 'text-error' : 'text-base-content/50'"
                x-text={`periodChange('petrol_98') ? (periodChange('petrol_98').delta >= 0 ? '+' : '') + periodChange('petrol_98').delta.toFixed(3) + ' ${currency}' : '—'`}></span>
          <span class="text-base-content/30 text-xs"
                x-show="periodChange('petrol_98') !== null"
                x-text="periodChange('petrol_98') ? '(' + (periodChange('petrol_98').pct >= 0 ? '+' : '') + periodChange('petrol_98').pct.toFixed(1) + '%)' : ''"></span>
        </div>
      </div>

      <!-- Chart canvas -->
      <div class="h-64 md:h-80">
        <canvas x-ref="priceChart"></canvas>
      </div>
    </div>
  </div>
</div>

