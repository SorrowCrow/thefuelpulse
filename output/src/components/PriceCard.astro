---
import { calculatePriceChange, getPriceTrend } from '@/utils/priceHelpers';
import { formatDateTime } from '@/utils/dateHelpers';
import { t } from '@/i18n/utils';
import pricesData from '@/data/prices.json';
import historyData from '@/data/price-history.json';
import stationPricesRaw from '@/data/station-prices.json';
import type { Language } from '@/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const { averages, currency, last_updated } = pricesData;

// Find the entry closest to 7 days ago for a meaningful "week change" indicator
const weekAgoDate = new Date(last_updated);
weekAgoDate.setDate(weekAgoDate.getDate() - 7);
const weekAgoStr = weekAgoDate.toISOString().split('T')[0];
const prev = historyData.history.find(h => h.date <= weekAgoStr) ?? historyData.history[1];

function fuelStat(curr: number, prevPrice: number | undefined) {
  const { changeValue, changePercentage } = calculatePriceChange(curr, prevPrice);
  const trend = getPriceTrend(changeValue);
  const icon = trend === 'up' ? '▲' : trend === 'down' ? '▼' : '—';
  const badgeClass = trend === 'up' ? 'badge-error' : trend === 'down' ? 'badge-success' : 'badge-ghost';
  return { changeValue, changePercentage, icon, badgeClass };
}

const diesel = fuelStat(averages.diesel, prev?.diesel);
const p95 = fuelStat(averages.petrol_95, prev?.petrol_95);
const p98 = fuelStat(averages.petrol_98, prev?.petrol_98);

const updatedText = t(lang, 'price.updated').replace('{time}', formatDateTime(last_updated, 'en'));

interface PremiumCard {
  brand: string;
  fuel_name: string;
  price: number;
  category: string;
  currency: string;
}

const premiumCards: PremiumCard[] = [];
const rawStations = (stationPricesRaw as any).stations ?? [];
for (const station of rawStations) {
  const entries = station.fuel_entries ?? [];
  for (const entry of entries) {
    if (entry.category === 'premium' || entry.category === 'specialty') {
      premiumCards.push({
        brand: station.brand,
        fuel_name: entry.fuel_name,
        price: entry.price,
        category: entry.category,
        currency: entry.currency ?? 'EUR',
      });
    }
  }
}
---

<div class="card bg-base-100 border border-base-300 shadow-xl p-4 md:p-6 mb-8" data-reveal>
  <div class="card-body p-0">
    <div class="flex justify-between items-baseline mb-4">
      <h2 class="card-title text-2xl md:text-3xl">{t(lang, 'price.title')}</h2>
      <span class="text-xs text-base-content/40">{t(lang, 'price.avg')}</span>
    </div>

    <div class="stats stats-vertical lg:stats-horizontal shadow w-full bg-base-200">
      <div class="stat">
        <div class="stat-title">{t(lang, 'fuel.diesel')}</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.diesel.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', diesel.badgeClass]}>
            {diesel.icon} {Math.abs(diesel.changeValue).toFixed(3)}
          </span>
          {diesel.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({diesel.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>

      <div class="stat">
        <div class="stat-title">{t(lang, 'fuel.petrol95')}</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.petrol_95.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', p95.badgeClass]}>
            {p95.icon} {Math.abs(p95.changeValue).toFixed(3)}
          </span>
          {p95.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({p95.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>

      <div class="stat">
        <div class="stat-title">{t(lang, 'fuel.petrol98')}</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.petrol_98.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', p98.badgeClass]}>
            {p98.icon} {Math.abs(p98.changeValue).toFixed(3)}
          </span>
          {p98.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({p98.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>
    </div>

    {premiumCards.length > 0 && (
      <div class="mt-4">
        <p class="text-xs text-base-content/40 mb-2 uppercase tracking-wider">Premium & Specialty</p>
        <div class="flex gap-2 overflow-x-auto pb-1">
          {premiumCards.map(card => (
            <div class="card card-compact bg-base-200 border border-base-300 shrink-0 min-w-[160px]">
              <div class="card-body p-3">
                <p class="text-xs text-base-content/50 font-medium">{card.brand}</p>
                <p class="text-sm font-semibold leading-tight">{card.fuel_name}</p>
                <p class="font-mono text-primary text-base">{card.price.toFixed(3)} {card.currency}</p>
                <span class:list={[
                  'badge badge-xs self-start',
                  card.category === 'premium' ? 'badge-warning' : 'badge-info'
                ]}>{card.category}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <p class="text-xs text-base-content/40 mt-3">
      {updatedText}
      {prev?.date && <span class="ml-2 opacity-60">· {t(lang, 'price.vs_week').replace('{date}', prev.date)}</span>}
    </p>
  </div>
</div>
