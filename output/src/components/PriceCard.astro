---
import { calculatePriceChange, getPriceTrend } from '@/utils/priceHelpers';
import { formatDateTime } from '@/utils/dateHelpers';
import pricesData from '@/data/prices.json';
import historyData from '@/data/price-history.json';

const { averages, currency, last_updated } = pricesData;
const prev = historyData.history[1];

function fuelStat(curr: number, prevPrice: number | undefined) {
  const { changeValue, changePercentage } = calculatePriceChange(curr, prevPrice);
  const trend = getPriceTrend(changeValue);
  const icon = trend === 'up' ? '▲' : trend === 'down' ? '▼' : '—';
  const badgeClass = trend === 'up' ? 'badge-error' : trend === 'down' ? 'badge-success' : 'badge-ghost';
  return { changeValue, changePercentage, icon, badgeClass };
}

const diesel = fuelStat(averages.diesel, prev?.diesel);
const p95 = fuelStat(averages.petrol_95, prev?.petrol_95);
const p98 = fuelStat(averages.petrol_98, prev?.petrol_98);
---

<div class="card bg-base-100 border border-base-300 shadow-xl p-4 md:p-6 mb-8" data-reveal>
  <div class="card-body p-0">
    <div class="flex justify-between items-baseline mb-4">
      <h2 class="card-title text-2xl md:text-3xl">Fuel Prices</h2>
      <span class="text-xs text-base-content/40">avg · 4 stations</span>
    </div>

    <div class="stats stats-vertical lg:stats-horizontal shadow w-full bg-base-200">
      <div class="stat">
        <div class="stat-title">Diesel</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.diesel.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', diesel.badgeClass]}>
            {diesel.icon} {Math.abs(diesel.changeValue).toFixed(3)}
          </span>
          {diesel.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({diesel.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>

      <div class="stat">
        <div class="stat-title">Petrol 95</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.petrol_95.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', p95.badgeClass]}>
            {p95.icon} {Math.abs(p95.changeValue).toFixed(3)}
          </span>
          {p95.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({p95.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>

      <div class="stat">
        <div class="stat-title">Petrol 98</div>
        <div class="stat-value text-4xl tabular text-primary">{averages.petrol_98.toFixed(3)} {currency}</div>
        <div class="stat-desc">
          <span class:list={['badge badge-sm text-xs', p98.badgeClass]}>
            {p98.icon} {Math.abs(p98.changeValue).toFixed(3)}
          </span>
          {p98.changePercentage !== 0 &&
            <span class="ml-1 opacity-60">({p98.changePercentage.toFixed(1)}%)</span>
          }
        </div>
      </div>
    </div>

    <p class="text-xs text-base-content/40 mt-3">
      Updated {formatDateTime(last_updated, 'en')} local time
    </p>
  </div>
</div>
