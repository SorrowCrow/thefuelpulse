---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — The Fuel Pulse" description="Get in touch with The Fuel Pulse team for questions, data corrections, or partnership enquiries.">
  <div class="max-w-xl mx-auto" data-reveal>

    <a href="/" class="text-xs text-base-content/40 hover:text-primary transition-colors mb-3 inline-block">← Back to dashboard</a>
    <h1 class="text-3xl md:text-4xl font-bold mb-2">Contact</h1>
    <p class="text-base-content/60 mb-8">We'd love to hear from you.</p>

    <div class="card bg-base-100 border border-base-300 p-6 md:p-8 space-y-6">

      <div>
        <h2 class="text-sm font-semibold text-base-content/50 uppercase tracking-wide mb-1">General enquiries</h2>
        <a href="mailto:info@thefuelpulse.com" class="link link-primary text-lg">info@thefuelpulse.com</a>
        <p class="text-sm text-base-content/50 mt-1">Questions about the site, data, or our methodology.</p>
      </div>

      <div class="divider"></div>

      <div>
        <h2 class="text-sm font-semibold text-base-content/50 uppercase tracking-wide mb-1">Data corrections</h2>
        <a href="mailto:data@thefuelpulse.com" class="link link-primary text-lg">data@thefuelpulse.com</a>
        <p class="text-sm text-base-content/50 mt-1">Spotted a wrong price or stale data? Let us know and we'll investigate.</p>
      </div>

      <div class="divider"></div>

      <div>
        <h2 class="text-sm font-semibold text-base-content/50 uppercase tracking-wide mb-1">Advertising &amp; partnerships</h2>
        <a href="mailto:ads@thefuelpulse.com" class="link link-primary text-lg">ads@thefuelpulse.com</a>
        <p class="text-sm text-base-content/50 mt-1">Sponsorship, partnership, or advertising opportunities.</p>
      </div>

      <div class="divider"></div>

      <p class="text-xs text-base-content/30">
        We typically respond within 1–2 business days.
      </p>

    </div>
  </div>
</BaseLayout>
