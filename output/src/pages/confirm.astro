---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscription confirmed — The Fuel Pulse"
  description="Email subscription confirmation for fuel price alerts."
  lang="en"
>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div
      x-data="{ status: 'loading' }"
      x-init="
        const token = new URLSearchParams(window.location.search).get('token');
        if (!token) {
          status = 'error';
        } else {
          fetch('/api/confirm?token=' + token)
            .then(r => r.json())
            .then(d => { status = d.status === 'confirmed' ? 'confirmed' : 'not_found'; })
            .catch(() => { status = 'error'; });
        }
      "
      class="card bg-base-200 p-8 max-w-md w-full text-center"
    >
      <!-- Loading -->
      <div x-show="status === 'loading'" class="loading loading-spinner loading-lg mx-auto"></div>

      <!-- Confirmed -->
      <div x-show="status === 'confirmed'">
        <div class="text-4xl mb-4">&#10003;</div>
        <h1 class="text-xl font-bold mb-2">Subscription confirmed!</h1>
        <p class="text-base-content/70">You'll receive fuel price alerts at your email.</p>
        <a href="/" class="btn btn-primary mt-6">Go to site</a>
      </div>

      <!-- Not found or error -->
      <div x-show="status === 'not_found' || status === 'error'">
        <div class="text-4xl mb-4">&#10007;</div>
        <h1 class="text-xl font-bold mb-2">Link expired or invalid</h1>
        <p class="text-base-content/70">This confirmation link is no longer valid.</p>
        <a href="/" class="btn btn-ghost mt-6">Go to site</a>
      </div>
    </div>
  </div>
</BaseLayout>
